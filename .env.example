# --- App ---
APP_HOST=127.0.0.1
APP_PORT=8000
# Generic DEBUG vars from external toolchains may use values like "release".
# This project treats release/prod as false and debug/dev as true.
DEBUG=false
LOG_LEVEL=INFO

# --- Security ---
# If set, all /api/* endpoints (and /metrics) require:  X-API-Key: <API_KEY>
# Strongly recommended when binding to 0.0.0.0 or exposing the service beyond localhost.
API_KEY=
# Safety default: refuse to start when binding to a non-localhost address without API_KEY.
PUBLIC_BIND_REQUIRES_API_KEY=true
# Comma-separated list of allowed Origins for browsers when DEBUG=false (exact match).
# Example: CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOW_ORIGINS=

# --- Retrieval ---
# sparse | dense | dual | hybrid (default is sparse for a lightweight base install)
# local_split + local_split:   sparse | dense | dual | hybrid
# elasticsearch + elasticsearch: sparse | dense | hybrid
# local_split + opensearch:    sparse | dense
# local_split + solr:          sparse only (v1)
RETRIEVAL_MODE=sparse
PERSISTENCE_BACKEND=local_split
# SEARCH_BACKEND controls which engine executes queries (independently of PERSISTENCE_BACKEND).
# Values: local_split | elasticsearch | opensearch | solr
SEARCH_BACKEND=local_split
HYBRID_RETRIEVAL_ALPHA=0.5
# Sparse candidate count fetched before dense rerank in dual mode (1..1000)
# DUAL_CANDIDATE_K=50

# --- SQLite / datos ---
# hardcoded example - path to common folder
SQLITE_URL=sqlite:///./data/app.db
FAQ_CSV=data/faq.csv
CSV_HAS_HEADER=true

# --- Ingesta / chunking ---
INGEST_CHUNK_STRATEGY=chars_v1
# Token de versionado para forzar re-chunk/re-embed en dedup hashes (aunque la estrategia no cambie).
INGEST_CHUNKER_VERSION=chars_v1
INGEST_CHUNK_CHARS=1200
INGEST_CHUNK_OVERLAP=200
INGEST_BATCH_SIZE=64
INGEST_CLEAN_LOWERCASE=true
INGEST_CLEAN_REMOVE_HTML=true
INGEST_CLEAN_COLLAPSE_WHITESPACE=true
INGEST_CLEAN_STRIP=true

# --- Embeddings (SentenceTransformers por defecto) ---
ST_EMBEDDING_MODEL=all-MiniLM-L6-v2
# local_split only
VECTOR_BACKEND=auto
INDEX_PATH=data/index.faiss
ID_MAP_PATH=data/id_map.json

# --- OpenSearch (SEARCH_BACKEND=opensearch; sparse/dense) ---
# OS_BASE_URL=
# OS_API_KEY=
# OS_USERNAME=
# OS_PASSWORD=
# OS_VERIFY_TLS=true
# OS_REQUEST_TIMEOUT_S=30.0
# OS_DOCS_INDEX=rag-docs
# OS_CONTENT_FIELD=content
# OS_EMBEDDING_FIELD=embedding
# OS_DENSE_CANDIDATE_K=50

# --- Solr (SEARCH_BACKEND=solr; sparse only in v1) ---
# SOLR_BASE_URL=
# SOLR_CORE=rag-docs
# SOLR_CONTENT_FIELD=content
# SOLR_REQUEST_TIMEOUT_S=30.0

# --- Elasticsearch (backend unificado; dense/hybrid only) ---
ES_BASE_URL=
ES_API_KEY=
ES_USERNAME=
ES_PASSWORD=
ES_VERIFY_TLS=true
ES_REQUEST_TIMEOUT_S=30.0
ES_DOCS_INDEX=rag-docs
ES_HISTORY_INDEX=rag-history
ES_SYSTEM_INDEX=rag-system
ES_TOMBSTONES_INDEX=rag-tombstones
ES_CONTENT_FIELD=content
ES_EMBEDDING_FIELD=embedding
ES_HYBRID_LEXICAL_K=50
ES_HYBRID_VECTOR_K=50

# --- OpenAI (opcional) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_REQUEST_TIMEOUT=60
OPENAI_TEMPERATURE=0.2
OPENAI_TOP_P=1.0
OPENAI_MAX_TOKENS=256

# --- Ollama (opcional) ---
OLLAMA_ENABLED=false
OLLAMA_MODEL=lfm2.5-thinking
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_REQUEST_TIMEOUT=180

# --- OpenRouter (opcional) ---
# Keep disabled by default; enable only when providing an API key.
OPENROUTER_ENABLED=false
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_SITE_URL=
OPENROUTER_APP_TITLE=Intrinsical RAG Prototype

# --- Prompt Templates ---
OPENAI_PROMPT_TEMPLATE=Answer using ONLY the context provided.\n\nCONTEXT:\n{context}\n\nQUESTION: {question}
OLLAMA_PROMPT_TEMPLATE=Based on the following context, please answer the question.\nIf the context does not provide an answer, say so.\n\nCONTEXT:\n{context}\n\nQUESTION:\n{question}

# --- Retrieval quality (reranker) ---
# ENABLE_RERANKER=false
# RERANKER_STRATEGY=overlap_v1
# RERANKER_CANDIDATE_K=20

# --- Consistency / write lock / mutation recovery ---
# STORAGE_PROFILE=                   # auto-inferred; override only if needed
# WRITE_LOCK_TIMEOUT_S=30.0
# WRITE_LOCK_POLL_S=0.05
# MUTATION_BATCH_MAX_SIZE=32
# MUTATION_BATCH_MAX_WAIT_MS=50
# MUTATION_RECOVERY_ENABLED=true
# MUTATION_RECOVERY_INTERVAL_S=30.0

# --- Monitoring (Prometheus) ---
ENABLE_MONITORING=false
