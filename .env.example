# --- App ---
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=false
LOG_LEVEL=INFO

# --- Retrieval ---
# sparse | dense | hybrid
RETRIEVAL_MODE=sparse
HYBRID_RETRIEVAL_ALPHA=0.5

# --- SQLite / datos ---
SQLITE_URL=sqlite:///./data/app.db
FAQ_CSV=data/faq.csv
CSV_HAS_HEADER=true

# --- Ingesta / chunking ---
INGEST_CHUNK_CHARS=1200
INGEST_CHUNK_OVERLAP=200

# --- Embeddings (SentenceTransformers por defecto) ---
ST_EMBEDDING_MODEL=all-MiniLM-L6-v2
INDEX_PATH=data/index.faiss
ID_MAP_PATH=data/id_map.pkl
ENABLE_FAISS_CONSISTENCY_CHECK=true

# --- OpenAI (opcional) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-3.5-turbo
OPENAI_TEMPERATURE=0.2
OPENAI_TOP_P=1.0
OPENAI_MAX_TOKENS=256
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Ollama (opcional) ---
OLLAMA_ENABLED=false
OLLAMA_MODEL=gemma3:1b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_REQUEST_TIMEOUT=90
