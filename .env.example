# =============================================================================
# Environment Configuration Example for Intrinsical RAG Prototype
# =============================================================================
# Copy this file to .env and customize the values for your environment

# === APPLICATION SETTINGS ===
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=false
LOG_LEVEL=INFO

# === RETRIEVAL CONFIGURATION ===
# Options: sparse, dense, hybrid
RETRIEVAL_MODE=sparse

# === OPENAI CONFIGURATION ===
# Required for OpenAI integration
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-3.5-turbo
OPENAI_TEMPERATURE=0.2
OPENAI_TOP_P=1.0
OPENAI_MAX_TOKENS=256
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# === OLLAMA CONFIGURATION ===
# Local LLM integration
OLLAMA_ENABLED=true
OLLAMA_MODEL=gemma3:1b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_REQUEST_TIMEOUT=90

# === SENTENCE TRANSFORMERS ===
# For local embeddings
ST_EMBEDDING_MODEL=all-MiniLM-L6-v2

# === FILE PATHS ===
DATA_DIR=data
INDEX_PATH=data/index.faiss
ID_MAP_PATH=data/id_map.pkl
FAQ_CSV=data/faq.csv
SQLITE_URL=sqlite:///./data/app.db

# === DATA PROCESSING ===
CSV_HAS_HEADER=true
AUTO_POPULATE_DB_ON_STARTUP=true
CREATE_DENSE_INDEX=true

# === PRODUCTION SETTINGS ===
# Set to 'production' for production deployment
ENVIRONMENT=development
