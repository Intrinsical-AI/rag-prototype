# =============================================================================
# MANIFEST.in - Package Data Inclusion for PyPI Distribution
# =============================================================================
# This file specifies which additional files to include in the source distribution

# === DOCUMENTATION ===
include README.md
include LICENSE
include CHANGELOG.md
include pyproject.toml

# === CONFIGURATION FILES (examples only) ===
include .env.example

# === DATA FILES ===
# Include sample data but exclude generated files
include data/faq.csv
include data/.gitkeep
exclude data/*.db
exclude data/*.sqlite*
exclude data/*.faiss
exclude data/*.pkl

# === DOCUMENTATION ===
recursive-include docs *.md *.png *.jpg *.svg
exclude docs/_build

# === FRONTEND ===
recursive-include frontend *.html *.css *.js

# === SCRIPTS ===
include scripts/*.py

# === SOURCE CODE ===
recursive-include src *.py
recursive-include tests *.py

# === EXCLUDE DEVELOPMENT FILES ===
exclude .coverage
exclude .env
exclude .env.local
exclude .env.*.local
exclude TODO.md
exclude *TODO.md*
exclude src_all_files.txt
exclude tests_all_files.txt
exclude tree*.txt

# === EXCLUDE BUILD ARTIFACTS ===
global-exclude __pycache__
global-exclude *.py[cod]
global-exclude *.so
global-exclude .DS_Store
global-exclude *.swp
global-exclude *.swo
global-exclude *~

# === EXCLUDE VERSION CONTROL ===
global-exclude .git*
global-exclude .hg*
global-exclude .svn*
