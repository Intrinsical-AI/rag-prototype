# =============================================================================
# Python RAG Prototype - Production .gitignore
# =============================================================================
# Based on GitHub's Python.gitignore template with RAG-specific additions
# https://github.com/github/gitignore/blob/main/Python.gitignore

# === PYTHON BYTECODE & COMPILED FILES ===
__pycache__/
*.py[cod]
*$py.class
*.so

# === DISTRIBUTION & PACKAGING ===
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# === PYINSTALLER ===
*.manifest
*.spec

# === INSTALLER LOGS ===
pip-log.txt
pip-delete-this-directory.txt

# === TESTING & COVERAGE ===
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
.pytest_cache/
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
cover/

# === TRANSLATIONS ===
*.mo
*.pot

# === DJANGO/FLASK SPECIFIC ===
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal
instance/
.webassets-cache

# === SCRAPY ===
.scrapy

# === DOCUMENTATION ===
docs/_build/
site/

# === PYBUILDER ===
.pybuilder/
target/

# === JUPYTER NOTEBOOK ===
.ipynb_checkpoints

# === IPYTHON ===
profile_default/
ipython_config.py

# === ENVIRONMENTS ===
.env
.env.local
.env.*.local
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# === DEPENDENCY MANAGEMENT ===
__pypackages__/
.pdm.toml
.pdm-python
.pdm-build/
.uv_cache/

# === CELERY ===
celerybeat-schedule
celerybeat.pid

# === SAGEMATH ===
*.sage.py

# === EDITORS & IDES ===
.vscode/
.idea/
.spyderproject
.spyproject
.ropeproject
*.sublime-project
*.sublime-workspace

# === VIM ===
*.swp
*.swo
*.swn
*~

# === CODE QUALITY TOOLS ===
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/
.ruff_cache/
cython_debug/

# === OPERATING SYSTEM ===
# macOS
.DS_Store
.AppleDouble
.LSOverride
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# =============================================================================
# RAG-SPECIFIC IGNORES
# =============================================================================

# === DATA FILES ===
# Keep sample data but ignore large datasets
data/*.db
data/*.sqlite*
data/*.faiss
data/*.pkl
data/*.lock
data/id_map.json
data/.rag_service_reload_token
data/.rag_service_reload_token.tmp
data/embeddings/
data/models/
# Keep the sample CSV for testing
!data/faq.csv
!data/.gitkeep

# === MACHINE LEARNING MODELS ===
models/
*.pt
*.pth
*.h5
*.keras
*.pb
*.onnx
*.bin
*.joblib
*.model

# === VECTOR DATABASES & EMBEDDINGS ===
vectordb/
*.emb
**/embeddings_batches/

# === CREDENTIALS & SECRETS ===
credentials.*
secrets.*
*.pem
*.key
*.p12
*.pfx
.pypirc

# === LOGS ===
logs/
*.log.*

# === TEMPORARY & DEVELOPMENT FILES ===
TODO.md
*TODO.md*
src_all_files.txt
tests_all_files.txt
tree*.txt
temp/
tmp/

# === GENERATED REPORTS ===
reports/
output/
plots/
figures/

.locals/
.github/workflows/release.yml

build_package.py
concatenate_src.py

/pr

medium-blog/
curso/

openai**

.pre-commit-cache