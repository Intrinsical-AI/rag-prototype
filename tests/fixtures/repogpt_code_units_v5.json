      "start_line": 1,
      "end_line": 8,
      "content": "def extract_bearer_token(auth_header: str | None) -> str | None:\n    \"\"\"Extract a bearer token from an Authorization header.\"\"\"\n    if not auth_header:\n        return None\n    scheme, _, token = auth_header.partition(\" \")\n    if scheme.lower() != \"bearer\":\n        return None\n    return token.strip() or None\n",
