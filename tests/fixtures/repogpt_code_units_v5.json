      "content": "def validate_token(token: str) -> bool:\n    \"\"\"Validate an auth token using a signed prefix and minimum length.\"\"\"\n    cleaned = token.strip()\n    return cleaned.startswith(\"signed-\") and len(cleaned) >= 12\n",
